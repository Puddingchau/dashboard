rules_version = '2';
// Project: pudding-dashboard-5d8c8
// Bucket: pudding-dashboard-5d8c8.firebasestorage.app
//
// Legacy Firebase Storage rules. Event files now go to the owner's Google Drive.
// The dashboard does not upload or download through this bucket, and Blaze is
// not required. If the bucket is ever enabled, these rules still deny everyone
// except the signed-in uid, and they never allow public read.
// Path: users/{uid}/events/{eventId}/{attachmentId}/{fileName}
//
// The dashboard does not deploy or call this bucket. Leave Storage disabled.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/events/{eventId}/{attachmentId}/{fileName} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // listAll when an event is deleted. Read and delete only, so this
    // match cannot bypass the 10MB create limit above.
    match /users/{uid}/events/{eventId}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
    }
  }
}
